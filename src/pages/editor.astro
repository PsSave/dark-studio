---
import Workspace from '../layouts/Workspace.astro';
---
<Workspace title="Editor de recortes" section="editor" module="02">
<section class="title"><div><p class="eyebrow">DO ACERVO PARA O SEU PRÓXIMO CORTE</p><h1>Escolha o que fica<span>.</span></h1><p>Marque o trecho, confira a prévia e salve um novo vídeo.</p></div><a class="back-link" href="/">← Voltar ao acervo</a></section>
<div id="editor-message" role="status" aria-live="polite"></div>
<div id="no-sources" class="empty" hidden><div class="empty-icon">✂</div><h3>Seu editor começa com um vídeo.</h3><p>Adicione um perfil na biblioteca para trazer vídeos ao acervo.</p><a class="download-all" href="/">Abrir biblioteca</a></div>
<div id="workspace" class="editor-workspace">
<section class="cut-stage" aria-label="Prévia do vídeo">
<div class="source-picker"><label for="source">Vídeo do acervo</label><select id="source" disabled><option>Carregando vídeos…</option></select></div>
<div class="preview-wrap"><video id="preview" controls preload="metadata" playsinline></video><div id="preview-empty">Selecione um vídeo para começar.</div><span class="preview-tag">ORIGINAL</span></div>
<div class="player-meta"><span id="source-meta">—</span><a id="source-link" target="_blank" rel="noopener noreferrer" hidden>Ver publicação original ↗</a></div>
<div class="timeline" aria-label="Trecho selecionado"><div class="timeline-top"><strong>Seu recorte</strong><span id="selection-summary">—</span></div><div class="selection-track"><div id="selection-fill"></div><div id="playhead"></div></div><div class="timeline-labels"><span>00:00</span><span id="total-duration">—</span></div><div class="range-line"><label for="start-range">Início</label><input type="range" id="start-range" min="0" max="100" step="0.1" value="0" disabled/><output id="start-value">00:00.0</output></div><div class="range-line"><label for="end-range">Fim</label><input type="range" id="end-range" min="0" max="100" step="0.1" value="100" disabled/><output id="end-value">00:00.0</output></div></div>
<div class="preview-actions"><button id="play-selection" class="secondary" disabled>▶ Ver apenas o trecho</button><span id="preview-status">O original permanece no acervo.</span></div>
</section>
<section class="cut-settings" aria-labelledby="settings-title"><p class="eyebrow">CONFIGURAÇÃO DO RECORTE</p><h2 id="settings-title">Um novo trecho.</h2><p class="settings-description">Ajuste os pontos de corte em segundos.</p>
<form id="cut-form">
<label class="field">Nome do recorte<input id="clip-title" type="text" maxlength="100" required placeholder="Ex.: abertura Resident Evil" disabled/></label>
<div class="time-fields"><label class="field">Início (s)<input id="start" type="number" min="0" step="0.1" value="0" required disabled/></label><label class="field">Fim (s)<input id="end" type="number" min="0.2" step="0.1" required disabled/></label></div>
<div class="mark-buttons"><button id="mark-start" type="button" class="text-button" disabled>Usar posição como início</button><button id="mark-end" type="button" class="text-button" disabled>Usar posição como fim</button></div>
<label class="audio-option"><input id="muted" type="checkbox" disabled/><span><strong>Remover áudio</strong><small>Exportar o trecho sem som.</small></span></label>
<div class="export-summary"><span>Duração do recorte</span><strong id="clip-duration">—</strong><small>MP4 · Mesma proporção do original</small></div>
<button id="export-clip" type="submit" disabled>Exportar recorte <span>↗</span></button><p id="form-hint">Os recortes são salvos localmente, sem alterar o original.</p>
</form></section></div>
<section class="clips-section"><div class="section-heading"><h2>Recortes exportados <span id="clips-count">0</span></h2><span class="saved-hint">Salvos neste computador</span></div><div id="clips-empty" class="clips-empty">Seus recortes aparecem aqui depois da primeira exportação.</div><div id="clips-list" class="clips-list"></div></section>
<dialog id="clip-dialog"><div class="dialog-top"><h2 id="dialog-title">Prévia do recorte</h2><button id="close-dialog" aria-label="Fechar prévia" class="secondary">✕</button></div><video id="clip-player" controls playsinline></video><a id="dialog-download" class="download-all">↓ Baixar recorte</a></dialog>
<script>
const $=(selector:string)=>document.querySelector(selector) as HTMLElement;
const sourceSelect=$('#source') as HTMLSelectElement, player=$('#preview') as HTMLVideoElement, title=$('#clip-title') as HTMLInputElement;
const startInput=$('#start') as HTMLInputElement,endInput=$('#end') as HTMLInputElement,startRange=$('#start-range') as HTMLInputElement,endRange=$('#end-range') as HTMLInputElement,muted=$('#muted') as HTMLInputElement,exportButton=$('#export-clip') as HTMLButtonElement;
let sources:any[]=[],selected:any=null,clips:any[]=[],loading=false,submitting=false,previewing=false,requestVersion=0,lastClips='';
function time(seconds:number){if(!Number.isFinite(seconds))return '—';const m=Math.floor(seconds/60),s=seconds%60;return `${String(m).padStart(2,'0')}:${s.toFixed(1).padStart(4,'0')}`;}
function node(tag:string,text:string,cls=''){const el=document.createElement(tag);el.textContent=text;el.className=cls;return el;}
function message(text:string,error=false){$('#editor-message').textContent=text;$('#editor-message').classList.toggle('problem',error);}
function bounds(){return {start:Number(startInput.value),end:Number(endInput.value)};}
function valid(){const {start,end}=bounds();return selected&&!loading&&startInput.value!==''&&endInput.value!==''&&Number.isFinite(start)&&Number.isFinite(end)&&start>=0&&end<=selected.duration+.02&&end-start>=.19999999&&title.value.trim().length>0;}
function update(){
 const {start,end}=bounds(),duration=selected?.duration||1;
 $('#start-value').textContent=time(start);$('#end-value').textContent=time(end);$('#selection-summary').textContent=`${time(start)} → ${time(end)}`;
 $('#clip-duration').textContent=valid()?time(end-start):'—';startRange.value=String(start);endRange.value=String(end);
 $('#selection-fill').style.left=`${Math.max(0,Math.min(100,start/duration*100))}%`;$('#selection-fill').style.width=`${Math.max(0,Math.min(100,(end-start)/duration*100))}%`;
 const busy=clips.some(c=>c.status==='rendering');exportButton.disabled=!valid()||busy||submitting;
 ($('#play-selection') as HTMLButtonElement).disabled=!valid();
 exportButton.textContent=submitting?'Preparando exportação…':busy?'Exportação em andamento…':'Exportar recorte ↗';
 player.muted=muted.checked;
 if(selected&&!loading){try{localStorage.setItem(`dark-cut:${selected.id}`,JSON.stringify({start,end,title:title.value,muted:muted.checked}));}catch{}}
}
function stopPreview(){previewing=false;$('#play-selection').textContent='▶ Ver apenas o trecho';$('#preview-status').textContent='O original permanece no acervo.';}
function controls(disabled:boolean){for(const selector of ['#clip-title','#start','#end','#start-range','#end-range','#muted','#mark-start','#mark-end'])($(selector) as HTMLInputElement).disabled=disabled;}
async function select(id:string,restore:any=null){
 const version=++requestVersion;loading=true;controls(true);stopPreview();player.pause();player.removeAttribute('src');player.load();$('#preview-empty').hidden=false;$('#preview-empty').textContent='Carregando vídeo…';update();
 try{
 const response=await fetch(`/api/editor?source=${encodeURIComponent(id)}`),data=await response.json();if(!response.ok)throw Error(data.error);
 if(version!==requestVersion)return;selected=data;sourceSelect.value=id;
 let draft=restore; if(!draft){try{draft=JSON.parse(localStorage.getItem(`dark-cut:${id}`)||'null');}catch{}}
 const duration=data.duration;for(const input of [startInput,endInput,startRange,endRange])input.max=String(duration);
 const draftStart=Number(draft?.start),draftEnd=Number(draft?.end);
 const useDraft=draft&&Number.isFinite(draftStart)&&Number.isFinite(draftEnd)&&draftStart>=0&&draftEnd<=duration&&draftEnd-draftStart>=.19999999;
 startInput.value=String(useDraft?draftStart:0);endInput.value=String(useDraft?draftEnd:Math.floor(Math.min(15,duration)*10)/10);
 title.value=typeof draft?.title==='string'?draft.title:`Recorte de @${data.profile}`;muted.checked=!!draft?.muted;
 $('#total-duration').textContent=time(duration);$('#source-meta').textContent=`${data.width} × ${data.height} · ${time(duration)} · ${data.hasAudio?'Com áudio':'Sem áudio'}`;
 const original=$('#source-link') as HTMLAnchorElement;original.href=data.source;original.hidden=false;
 player.src=`/api/media?id=${encodeURIComponent(id)}`;player.load();loading=false;controls(false);update();message('');
 history.replaceState(null,'',`/editor?video=${encodeURIComponent(id)}`);
 }catch(error){if(version!==requestVersion)return;loading=false;selected=null;controls(true);$('#preview-empty').textContent='Não foi possível abrir este vídeo.';message(error.message,true);update();}
}
player.addEventListener('loadedmetadata',()=>{$('#preview-empty').hidden=true;player.currentTime=bounds().start;});
player.addEventListener('error',()=>{if(selected){message('O player não conseguiu abrir o arquivo. Confira se ele continua no acervo.',true);}});
player.addEventListener('timeupdate',()=>{
 $('#playhead').style.left=`${Math.max(0,Math.min(100,player.currentTime/(selected?.duration||1)*100))}%`;
 if(previewing&&player.currentTime>=bounds().end){player.pause();player.currentTime=bounds().end;stopPreview();$('#preview-status').textContent='Fim do trecho selecionado.';}
});
player.addEventListener('seeking',()=>{if(previewing&&(player.currentTime<bounds().start||player.currentTime>bounds().end))stopPreview();});
$('#play-selection').addEventListener('click',async()=>{
 if(previewing){player.pause();stopPreview();return;}if(!valid())return;
 player.currentTime=bounds().start;previewing=true;$('#play-selection').textContent='Ⅱ Pausar trecho';$('#preview-status').textContent='Reproduzindo apenas o trecho selecionado.';
 try{await player.play();}catch{stopPreview();message('Clique no player para iniciar a reprodução.',true);}
});
function change(){stopPreview();player.pause();update();}
for(const input of [startInput,endInput,title,muted])input.addEventListener('input',change);
startRange.addEventListener('input',()=>{startInput.value=String(Math.min(Number(startRange.value),Math.max(0,bounds().end-.2)));change();player.currentTime=bounds().start;});
endRange.addEventListener('input',()=>{endInput.value=String(Math.max(Number(endRange.value),Math.min(selected.duration,bounds().start+.2)));change();player.currentTime=bounds().end;});
$('#mark-start').addEventListener('click',()=>{startInput.value=String(Math.round(player.currentTime*10)/10);change();});$('#mark-end').addEventListener('click',()=>{endInput.value=String(Math.min(selected.duration,Math.round(player.currentTime*10)/10));change();});
sourceSelect.addEventListener('change',()=>select(sourceSelect.value));
$('#cut-form').addEventListener('submit',async event=>{
 event.preventDefault();if(!valid())return;submitting=true;update();stopPreview();player.pause();
 try{const {start,end}=bounds(),response=await fetch('/api/editor',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({sourceId:selected.id,title:title.value,start,end,muted:muted.checked})}),data=await response.json();if(!response.ok)throw Error(data.error);message('Exportação iniciada. Você pode acompanhar o progresso abaixo.');await refreshClips();}
 catch(error){message(error.message,true);}finally{submitting=false;update();}
});
const dialog=$('#clip-dialog') as HTMLDialogElement,clipPlayer=$('#clip-player') as HTMLVideoElement;
$('#close-dialog').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>{clipPlayer.pause();clipPlayer.removeAttribute('src');clipPlayer.load();});
function renderClips(){
 $('#clips-count').textContent=String(clips.filter(c=>c.status==='completed').length);$('#clips-empty').hidden=clips.length>0;
 const signature=JSON.stringify(clips);if(signature===lastClips){update();return;}lastClips=signature;const list=$('#clips-list');list.replaceChildren();
 const labels:any={rendering:'Exportando',completed:'Pronto',failed:'Falha',interrupted:'Interrompido'};
 for(const clip of clips){
 const card=node('article','','clip-row'),icon=node('div',clip.status==='completed'?'✓':'✂','clip-icon'),info=node('div','','clip-info');
 info.append(node('h3',clip.title),node('p',`${time(clip.start)} → ${time(clip.end)} · ${time(clip.end-clip.start)} · ${clip.muted?'Sem áudio':'Áudio original'}`));
 if(clip.status==='rendering'){const progress=document.createElement('progress');progress.max=100;progress.value=clip.progress;progress.setAttribute('aria-label',`Exportando ${clip.title}`);info.append(progress);}
 if(clip.error)info.append(node('p',clip.error,'error'));
 const actions=node('div','','clip-actions');actions.append(node('span',`${labels[clip.status]}${clip.status==='rendering'?` ${clip.progress}%`:''}`,'clip-state'));
 if(clip.status==='completed'){
 const view=node('button','Ver','secondary');view.addEventListener('click',()=>{$('#dialog-title').textContent=clip.title;clipPlayer.src=`/api/media?kind=clip&id=${clip.id}`;const link=$('#dialog-download') as HTMLAnchorElement;link.href=`/api/media?kind=clip&id=${clip.id}&download=1`;dialog.showModal();});actions.append(view);
 const download=document.createElement('a');download.className='download-all';download.textContent='↓ Baixar';download.href=`/api/media?kind=clip&id=${clip.id}&download=1`;actions.append(download);
 }
 const edit=node('button','Abrir ajuste','text-button');edit.addEventListener('click',()=>{select(clip.source_id,{start:clip.start,end:clip.end,title:clip.title,muted:!!clip.muted});$('#workspace').scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth',block:'start'});});actions.append(edit);
 card.append(icon,info,actions);list.append(card);
 }update();
}
async function refreshClips(){try{const response=await fetch('/api/editor'),data=await response.json();if(!response.ok)throw Error(data.error);clips=data.clips;renderClips();}catch(error){message(error.message,true);}}
async function init(){
 try{const response=await fetch('/api/library'),data=await response.json();if(!response.ok)throw Error(data.error);sources=data.videos.filter(v=>v.status==='downloaded');$('#workspace').hidden=!sources.length;$('#no-sources').hidden=!!sources.length;sourceSelect.replaceChildren();
 for(const source of sources){const option=document.createElement('option');option.value=source.id;option.textContent=`@${source.profile} · ${(source.caption||'Vídeo sem legenda').replace(/\s+/g,' ').slice(0,110)}`;sourceSelect.append(option);}
 sourceSelect.disabled=!sources.length;if(sources.length){const requested=new URLSearchParams(location.search).get('video');await select(sources.some(s=>s.id===requested)?requested:sources[0].id);}
 }catch(error){message(error.message||'Não foi possível carregar o acervo.',true);}await refreshClips();
}
init();setInterval(refreshClips,2000);
</script>
<style>
.back-link{font-size:14px;color:#b8c1ad}.editor-workspace{display:grid;grid-template-columns:minmax(0,1fr) 335px;gap:24px;align-items:start}.cut-stage,.cut-settings{background:#15181d;border:1px solid #303640;border-radius:12px;overflow:hidden}.source-picker{padding:18px 20px;border-bottom:1px solid #2d333c}.source-picker label{display:block;font-size:13px;color:#a0a9b4;margin-bottom:9px}.source-picker select{margin:0;width:100%;max-width:100%;font-size:14px}.preview-wrap{position:relative;display:flex;align-items:center;justify-content:center;background:#080a0c;height:385px}.preview-wrap video{max-width:100%;width:100%;height:100%;object-fit:contain}.preview-tag{position:absolute;left:14px;top:14px;font-size:10px;letter-spacing:1.5px;background:#20262ddd;color:#c4ccd7;padding:6px 9px;border-radius:5px;pointer-events:none}#preview-empty{position:absolute;color:#99a4b4;font-size:14px}.player-meta{padding:13px 20px;display:flex;align-items:center;justify-content:space-between;font-size:12px;color:#9da7b4;border-bottom:1px solid #2d333c}.player-meta a{color:#bac6ab}.timeline{padding:21px 20px 8px}.timeline-top{display:flex;justify-content:space-between;align-items:center;font-size:14px;margin-bottom:18px}.timeline-top span{color:#c0ef6c;font-variant-numeric:tabular-nums;font-size:12px}.selection-track{position:relative;height:25px;background:repeating-linear-gradient(90deg,#303742 0,#303742 1px,#202630 1px,#202630 8px);border-radius:4px;overflow:hidden}#selection-fill{position:absolute;top:0;bottom:0;background:#b8e87655;border-left:3px solid #c0ef6c;border-right:3px solid #c0ef6c}#playhead{position:absolute;top:0;bottom:0;width:2px;background:#fff;pointer-events:none}.timeline-labels{display:flex;justify-content:space-between;color:#858f9d;font-size:11px;margin:7px 0 13px;font-variant-numeric:tabular-nums}.range-line{display:flex;align-items:center;gap:12px;font-size:12px;color:#aab3bf}.range-line label{width:32px}.range-line output{width:58px;text-align:right;font-variant-numeric:tabular-nums}.range-line input{padding:0;accent-color:#c0ef6c;height:24px;min-width:0}.preview-actions{padding:16px 20px;display:flex;gap:12px;align-items:center}.preview-actions span{font-size:12px;line-height:1.5;color:#909ba9}.secondary{background:#252d37;color:#dde4ed;border:1px solid #3c4653;padding:10px 14px;white-space:nowrap}.cut-settings{padding:25px}.cut-settings .eyebrow{font-size:10px;letter-spacing:1.6px;margin:0 0 14px}.cut-settings h2{font-size:24px;letter-spacing:-.7px}.settings-description{font-size:13px;color:#9ca6b4;line-height:1.7;margin-bottom:24px}#cut-form{display:block}.field{display:block;font-size:13px;color:#bbc4cf;margin-bottom:18px}.field input{display:block;margin-top:9px;width:100%;padding:12px;border:1px solid #414a56;border-radius:6px;background:#0e1116;color:#e3e9f1;outline:none}.field input:focus{border-color:#c0ef6c}.time-fields{display:grid;grid-template-columns:1fr 1fr;gap:12px}.time-fields .field{margin-bottom:8px}.mark-buttons{display:flex;gap:12px;margin-bottom:25px}.text-button{padding:0;color:#c0d9a9;background:none;font-size:12px;font-weight:400;text-align:left;line-height:1.5}.audio-option{display:flex;align-items:center;gap:12px;padding:18px 0;border-top:1px solid #303640;border-bottom:1px solid #303640}.audio-option input{width:18px;height:18px;accent-color:#c0ef6c}.audio-option strong{font-size:14px;font-weight:500;display:block}.audio-option small{display:block;margin-top:5px;font-size:12px;color:#929fad}.export-summary{padding:24px 0}.export-summary>span{font-size:12px;color:#a6b1bf}.export-summary strong{display:block;font-size:35px;letter-spacing:-1px;margin:9px 0 8px;font-weight:500;font-variant-numeric:tabular-nums}.export-summary small{font-size:12px;color:#929dab}#export-clip{width:100%;padding:15px 12px}#form-hint{font-size:12px;line-height:1.6;color:#919dab;margin-bottom:0}.clips-section{margin-top:38px}.saved-hint{font-size:12px;color:#8995a5}.clips-empty{border:1px dashed #343d49;border-radius:10px;padding:28px;text-align:center;color:#9ba6b5;font-size:14px}.clips-list{display:grid;gap:12px}#editor-message:not(:empty){padding:13px 17px;border:1px solid #45513a;border-radius:7px;background:#1c2518;color:#ccdfb5;margin-bottom:20px;font-size:14px}#editor-message.problem{border-color:#7a3c43;background:#2b171d;color:#ffc3c9}dialog{border:1px solid #46515f;border-radius:13px;background:#151a21;color:#e5ebf3;padding:20px;width:min(800px,95vw);max-height:95vh}dialog::backdrop{background:#000b}dialog video{display:block;max-width:100%;width:100%;height:60vh;background:#07090c;margin:18px 0;object-fit:contain}.dialog-top{display:flex;justify-content:space-between;align-items:center;gap:15px}.dialog-top h2{font-size:18px}@media(max-width:1180px){.editor-workspace{grid-template-columns:minmax(0,1fr) 300px}.cut-settings{padding:20px}.preview-actions{flex-wrap:wrap}.player-meta{gap:10px;flex-wrap:wrap}.back-link{display:none}}@media(max-width:950px){.editor-workspace{grid-template-columns:1fr}.preview-wrap{height:400px}.cut-settings{padding:25px}.preview-actions{flex-wrap:nowrap}}@media(max-width:500px){.preview-wrap{height:350px}.source-picker{padding:15px}.timeline{padding:18px 15px 8px}.preview-actions{flex-wrap:wrap}.player-meta{padding:13px 15px}.saved-hint{display:none}}
</style>
<style is:global>.clip-row{display:flex;align-items:center;gap:16px;padding:20px;background:#171c23;border:1px solid #303b49;border-radius:9px}.clip-icon{background:#27351f;color:#c0ef6c;width:40px;height:45px;border-radius:7px;display:grid;place-items:center;font-size:20px;flex-shrink:0}.clip-info{flex:1;min-width:0}.clip-info h3{font-size:15px;margin:0 0 7px;overflow-wrap:anywhere}.clip-info p{font-size:12px;color:#9caabc;margin:0;line-height:1.6}.clip-info p.error{color:#ffb0bb;margin-top:8px}.clip-info progress{height:5px;width:100%;max-width:300px;margin-top:10px;accent-color:#c0ef6c}.clip-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:flex-end}.clip-state{font-size:12px;color:#a9bd94}.clip-actions .text-button{background:none;padding:0;color:#bdcca9;font-size:12px}.clip-actions .secondary{padding:8px 13px;color:#d5dfe9;background:#2b3440}.clip-actions .download-all{padding:9px 12px;font-size:13px}@media(max-width:900px){.clip-row{flex-wrap:wrap}.clip-actions{width:100%;justify-content:flex-start;padding-left:56px}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}}</style>
</Workspace>
