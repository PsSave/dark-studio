---
import Workspace from '../layouts/Workspace.astro';
---
<Workspace title="Criativos" section="creatives" module="03">
<section class="title"><div><p class="eyebrow">REVISE. BAIXE. PUBLIQUE.</p><h1>Criativos<span>.</span></h1><p>Seus vídeos finalizados, organizados e prontos para revisar.</p></div><a href="/editor" class="download-all">Criar no editor ↗</a></section>
<section class="creative-summary" aria-label="Resumo dos criativos"><div><span>CRIATIVOS PRONTOS</span><strong id="ready-count">—</strong></div><div><span>PARA REVISAR</span><strong id="review-count">—</strong></div><div><span>APROVADOS</span><strong id="approved-count">—</strong></div></section>
<div class="section-heading"><div><h2>Sua produção</h2><p class="muted-copy">Confira o enquadramento e o áudio antes de baixar.</p></div><label class="creative-filter">Exibir<select id="creative-filter"><option value="all">Todos os criativos</option><option value="review">Para revisar</option><option value="approved">Aprovados</option></select></label></div>
<p id="message" role="status"></p><div id="batch-list"></div>
<dialog id="review-dialog" aria-labelledby="review-title"><div class="review-heading"><div><p class="eyebrow">REVISÃO DO CRIATIVO</p><h2 id="review-title">Revisar vídeo</h2><p id="review-subtitle"></p></div><button id="close-review" class="ui-button ghost" aria-label="Fechar revisão">Fechar</button></div><video id="review-video" controls playsinline></video><div class="review-actions"><a id="edit-review" class="ui-button secondary">Ajustar no editor</a><a id="download-review" class="ui-button ghost">↓ Baixar vídeo</a><button id="approve-review" class="ui-button">Marcar como aprovado</button></div><p id="review-message" role="status"></p></dialog>
<script>import '../scripts/creatives.ts';</script>
<style is:global>
.creative-summary{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid #303944;border-radius:12px;background:#14191f;margin:0 0 32px;overflow:hidden}.creative-summary>div{padding:22px 26px;border-right:1px solid #303944}.creative-summary>div:last-child{border:0}.creative-summary span{display:block;font-size:10px;letter-spacing:1px;color:#9ba9b9}.creative-summary strong{display:block;font-size:30px;font-weight:500;font-variant-numeric:tabular-nums;margin-top:8px}.creative-summary>div:last-child strong{color:#c0ef6c}.muted-copy{font-size:13px;color:#9cabbc;line-height:1.6}.creative-filter{font-size:12px;color:#a3afbf}.batch-card{padding:24px;background:#14191f;border:1px solid #303944;border-radius:12px;margin:20px 0}.batch-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}.batch-heading h2{font-size:19px;overflow-wrap:anywhere}.batch-heading p{font-size:12px;color:#9eacbf;line-height:1.7;margin:6px 0}.batch-controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.batch-state,.creative-state{display:inline-flex;font-size:11px;padding:5px 9px;border:1px solid #3b4758;border-radius:6px;color:#b8c8dc;line-height:1.3}.batch-state.completed,.creative-state.approved{background:#c0ef6c0a;border-color:#4f6237;color:#c0ef6c}.batch-state.partial,.creative-state.failed{background:#ffb4a60a;border-color:#75473e;color:#ffb4a6}.creative-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;margin-top:22px}.creative-card{overflow:hidden;min-width:0;border:1px solid #354153;border-radius:10px;background:#0f151d}.creative-poster{position:relative;display:block;padding:0;width:100%;height:240px;border-radius:0;background:#090c10;color:#d5dfeb;overflow:hidden}.creative-poster video{width:100%;height:100%;object-fit:contain;display:block;pointer-events:none}.creative-poster .poster-label{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);margin:0;background:#101722e8;border:1px solid #6c7989;border-radius:20px;padding:8px 16px;white-space:nowrap;font-size:12px}.creative-content{padding:16px}.creative-card h3{font-size:15px;margin:12px 0 4px}.creative-card p{font-size:12px;color:#9faec1;margin:6px 0;line-height:1.7;overflow-wrap:anywhere}.creative-card p.error{color:#ffb0b0}.creative-actions{display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid #303944}.creative-actions .ui-button{flex:1;font-size:12px;padding:9px 8px;min-height:38px}.creative-card progress{width:100%;accent-color:#c0ef6c;height:6px}.creative-empty{padding:48px 24px;border:1px dashed #3e4b5e;border-radius:12px;color:#a7b8ce;text-align:center}.creative-empty h2{color:#d9e4f2}.creative-empty p{font-size:14px;line-height:1.7}#message{color:#ffbebe}#message:empty{display:none}#review-dialog{width:min(860px,95vw);max-height:94dvh;background:#141b24;border:1px solid #485669;border-radius:14px;color:#e0eafa}#review-dialog::backdrop{background:#000c}#review-video{display:block;width:100%;height:58dvh;background:#080b10;object-fit:contain;margin:18px 0;border-radius:8px}.review-heading{display:flex;align-items:flex-start;gap:18px;justify-content:space-between}.review-heading h2{font-size:19px;margin:4px 0}.review-heading .eyebrow{margin:0;font-size:9px}.review-heading>button{flex-shrink:0}#review-subtitle{font-size:12px;color:#a5b4c7;margin:6px 0 0}.review-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-top:2px}#approve-review{margin-left:auto}#review-message{font-size:13px;color:#c0ef6c;min-height:20px;margin:14px 0 0}@media(max-width:1150px){.creative-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.creative-grid{grid-template-columns:1fr}.batch-card{padding:16px}.creative-summary>div{padding:16px 10px}.creative-summary span{font-size:9px;letter-spacing:0}.creative-summary strong{font-size:25px}.review-actions>*{flex:1 1 140px}#approve-review{margin:0;flex-basis:100%}.creative-poster{height:300px}#review-video{height:50dvh}}
</style>
</Workspace>
