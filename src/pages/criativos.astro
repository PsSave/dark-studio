---
import Workspace from '../layouts/Workspace.astro';
---
<Workspace title="Criativos" section="creatives" module="03">
<section class="title"><div><p class="eyebrow">DO SEU MOLDE PARA O SEU ACERVO</p><h1>Criativos<span>.</span></h1><p>Produção em lote, revisão e seus vídeos prontos para baixar.</p></div><a href="/editor" class="download-all">Abrir editor ↗</a></section>
<p id="message" role="status"></p><div id="batch-list"></div>
<dialog id="review-dialog"><div class="review-heading"><h2 id="review-title">Revisar vídeo</h2><button id="close-review">Fechar</button></div><video id="review-video" controls playsinline></video><button id="approve-review">Marcar como aprovado</button><a id="download-review" class="download-all">↓ Baixar vídeo</a><p id="review-message" role="status"></p></dialog>
<script>
const $=(s:string)=>document.querySelector(s) as HTMLElement;let batches:any[]=[],signature='',review:any=null;
function node(tag:string,text:string,cls=''){const n=document.createElement(tag);n.textContent=text;n.className=cls;return n;}
async function action(payload:any){const r=await fetch('/api/creatives',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)}),data=await r.json();if(!r.ok)throw Error(data.error);return data;}
const dialog=$('#review-dialog') as HTMLDialogElement,player=$('#review-video') as HTMLVideoElement;
$('#close-review').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>{player.pause();player.removeAttribute('src');player.load();});
$('#approve-review').addEventListener('click',async()=>{if(!review)return;const button=$('#approve-review') as HTMLButtonElement;button.disabled=true;try{await action({action:'approve',batchId:review.batchId,sourceId:review.source_id,approved:!review.approved});review.approved=!review.approved;button.textContent=review.approved?'Retirar aprovação':'Marcar como aprovado';$('#review-message').textContent=review.approved?'Aprovado para uso. Nenhuma publicação foi feita.':'Voltou para revisão.';await refresh();}catch(e){$('#review-message').textContent=e.message;}finally{button.disabled=false;}});
async function refresh(){try{const r=await fetch('/api/creatives'),data=await r.json();if(!r.ok)throw Error(data.error);batches=data.batches;const next=JSON.stringify(batches);if(next===signature)return;signature=next;const list=$('#batch-list');list.replaceChildren();if(!batches.length){const empty=node('div','','creative-empty');empty.append(node('h2','Seus próximos criativos começam no Editor.'),node('p','Configure um vídeo e escolha “Aplicar a outros vídeos” para criar o primeiro lote.'));list.append(empty);}
 for(const b of batches){const section=node('section','','batch-card');section.id='batch-'+b.id;const header=node('div','','batch-heading'),heading=node('div');const ready=b.items.filter(i=>i.status==='completed').length,failed=b.items.filter(i=>i.status==='failed').length,approved=b.items.filter(i=>i.approved).length;heading.append(node('h2',b.name),node('p',`${b.recipe.template?.name||'Sem template'} · ${ready}/${b.items.length} prontos · ${failed} falhas · ${approved} aprovados`));header.append(heading);const controls=node('div','','batch-controls');const labels={running:'Em produção',completed:'Concluído',partial:'Concluído com falhas',interrupted:'Interrompido'};controls.append(node('span',labels[b.status]||b.status));if(ready){const zip=node('a','↓ Baixar lote (.zip)','download-all') as HTMLAnchorElement;zip.href='/api/export?batch='+b.id;controls.append(zip);}if(['partial','interrupted'].includes(b.status)){const retry=node('button','Retomar pendentes');retry.addEventListener('click',async()=>{(retry as HTMLButtonElement).disabled=true;try{await action({action:'retry',id:b.id});await refresh();}catch(e){$('#message').textContent=e.message;(retry as HTMLButtonElement).disabled=false;}});controls.append(retry);}header.append(controls);section.append(header);
 const grid=node('div','','creative-grid');for(const [index,item] of b.items.entries()){const card=node('article','','creative-card');card.append(node('h3',`Criativo ${index+1} · @${item.profile||'perfil'}`),node('p',item.status==='completed'?(item.approved?'✓ Aprovado':'Pronto para revisão'):item.status==='rendering'?`Exportando ${item.progress||0}%`:item.status==='failed'?'Falha':'Na fila'));if(item.error)card.append(node('p',item.error,'error'));if(item.status==='rendering'){const progress=document.createElement('progress');progress.max=100;progress.value=item.progress||0;card.append(progress);}if(item.status==='completed'){const watch=node('button','Revisar vídeo');watch.addEventListener('click',()=>{review={...item,batchId:b.id};$('#review-title').textContent=item.title||b.name;player.src='/api/media?kind=clip&id='+item.clip_id;($('#download-review') as HTMLAnchorElement).href=player.src+'&download=1';$('#approve-review').textContent=item.approved?'Retirar aprovação':'Marcar como aprovado';$('#review-message').textContent='';dialog.showModal();});const download=node('a','↓ Baixar') as HTMLAnchorElement;download.href='/api/media?kind=clip&id='+item.clip_id+'&download=1';card.append(watch,download);}const source=node('a','Abrir no editor') as HTMLAnchorElement;source.href='/editor?video='+encodeURIComponent(item.source_id);card.append(source);grid.append(card);}section.append(grid);list.append(section);}
 }catch(e){$('#message').textContent=e.message;}}
refresh();setInterval(refresh,2500);
</script>
<style is:global>
.batch-card{padding:24px;background:#151b22;border:1px solid #343e4c;border-radius:12px;margin:24px 0}.batch-heading{display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}.batch-heading h2{font-size:21px}.batch-heading p{font-size:13px;color:#a2b2c5;line-height:1.7}.batch-controls{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.batch-controls span{font-size:12px;color:#c0ef6c}.creative-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:18px}.creative-card{padding:18px;border:1px solid #354153;border-radius:8px;background:#0f151e}.creative-card h3{font-size:14px;overflow-wrap:anywhere}.creative-card p{font-size:12px;color:#a6b7cb;line-height:1.7}.creative-card p.error{color:#ffb0b0}.creative-card button{display:block;width:100%;padding:10px;margin:12px 0}.creative-card a{font-size:12px;display:inline-block;margin:8px 10px 0 0;color:#c0ef6c}.creative-card progress{width:100%;accent-color:#c0ef6c;height:6px}.creative-empty{padding:50px 25px;border:1px dashed #3e4b5e;border-radius:12px;color:#a7b8ce;text-align:center}.creative-empty h2{color:#d9e4f2}.creative-empty p{font-size:14px;line-height:1.7}#message{color:#ffbebe}#review-dialog{width:min(800px,95vw);max-height:94vh;background:#171e28;border:1px solid #485669;border-radius:12px;color:#e0eafa}#review-dialog::backdrop{background:#000c}#review-video{display:block;width:100%;height:60vh;background:#090b10;object-fit:contain;margin:18px 0}.review-heading{display:flex;align-items:center;gap:18px;justify-content:space-between}.review-heading h2{font-size:18px}#review-message{font-size:13px;color:#c0ef6c}@media(max-width:1050px){.creative-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.creative-grid{grid-template-columns:1fr}.batch-card{padding:18px}}
</style>
</Workspace>
